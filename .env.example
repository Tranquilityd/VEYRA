# Database (server only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Authentication (server only; generate a unique value of at least 32 characters)
API_SESSION_SECRET=replace-with-a-long-random-secret
WALLET_CHALLENGE_DOMAIN=localhost

# Casino claim signer (server only; never commit a real private key)
VEYRA_CASINO_SIGNER_PRIVATE_KEY=0xREPLACE_WITH_64_HEX_CHARACTERS
VEYRA_CASINO_SIGNER_ADDRESS=0xREPLACE_WITH_SIGNER_ADDRESS

# CAPTCHA verification secrets (server only)
HCAPTCHA_SECRET_KEY=replace-with-hcaptcha-secret
CLOUDFLARE_TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
SITE_ENTRY_CAPTCHA_PROVIDER=hcaptcha

# Public CAPTCHA build configuration (safe to expose to browsers)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=replace-with-public-hcaptcha-site-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-public-turnstile-site-key
NEXT_PUBLIC_SITE_ENTRY_CAPTCHA_PROVIDER=hcaptcha

# Optional LitVM server overrides; defaults come from config/deployments/liteforge.json
LITVM_RPC_URL=https://liteforge.rpc.caldera.xyz/http
LITEFORGE_RPC_URL=https://liteforge.rpc.caldera.xyz/http
LITVM_CONTRACT_CONFIG_JSON=

# Local database-backed E2E tests only
E2E_DATABASE_URL=postgresql://USER:PASSWORD@localhost/veyra_e2e
E2E_ALLOW_REMOTE_DATABASE=0

# Contract deployment tooling only; not required to run the existing deployment
DEPLOYER_PRIVATE_KEY=0xREPLACE_ONLY_IF_INTENTIONALLY_DEPLOYING
CONTRACT_OWNER_ADDRESS=0xREPLACE_WITH_OWNER_ADDRESS
AUTHORIZATION_SIGNER_ADDRESS=0xREPLACE_WITH_SIGNER_ADDRESS
